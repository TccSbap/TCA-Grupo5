DB_HOST=localhost
DB_PORT=3306
DB_USER=agua_consiente_user
DB_PASSWORD=change-me
DB_NAME=agua_consiente

SESSION_SECRET=change-me-to-a-long-random-secret
NODE_ENV=development
USE_MOCK_DB=false
WATCH_RELOAD=false
PORT=3000

# Mercado Pago Marketplace / Checkout Pro Orders.
# Para sandbox, use credenciais de producao da aplicacao e conecte contas de teste.
# A Orders API nao aceita tokens OAuth emitidos com test_token=true.
APP_URL=https://agua-consciente.onrender.com
MP_MARKETPLACE_CLIENT_ID=
MP_MARKETPLACE_CLIENT_SECRET=
MP_MARKETPLACE_APP_ACCESS_TOKEN=
MP_MARKETPLACE_OAUTH_REDIRECT_URI=https://agua-consciente.onrender.com/mercadopago/oauth/callback
MP_MARKETPLACE_WEBHOOK_SECRET=
# Base64 de uma chave aleatória de 32 bytes; mantenha a mesma chave após salvar tokens.
MP_TOKEN_ENCRYPTION_KEY=

# Assistente IA do site (desativado até a confirmação das condições de uso)
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_TERMS_CONFIRMED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/google/gemma-4-26b-a4b-it

# Conta geral do projeto — aplicação AguaConscienteDoacoes (Checkout Pro / Orders)
MP_PROJECT_ACCESS_TOKEN=
MP_PROJECT_WEBHOOK_SECRET=
