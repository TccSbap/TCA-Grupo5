MP_MARKETPLACE_WEBHOOK_SECRET=
MP_MARKETPLACE_TEST_MODE=true
# Base64 de uma chave aleatória de 32 bytes; mantenha a mesma chave após salvar tokens.
MP_TOKEN_ENCRYPTION_KEY=

# Conta geral do projeto — aplicação AguaConscienteDoacoes (Checkout Pro / Orders)
MP_PROJECT_ACCESS_TOKEN=
