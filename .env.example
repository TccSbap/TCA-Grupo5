SESSION_SECRET=change-me-to-a-long-random-secret
NODE_ENV=development
USE_MOCK_DB=false
WATCH_RELOAD=false
PORT=3000

# Mercado Pago Split 1:1 — conta de integrador / aplicação Checkout Pro Orders
