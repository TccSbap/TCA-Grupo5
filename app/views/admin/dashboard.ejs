<%- include('../partials/header') %>

<section class="admin-container">
    <aside class="admin-sidebar">
        <nav class="admin-nav">
            <nav class="admin-nav-header">
                <h2>Administrador</h2>
                <p><%= user.name %></p>
            </nav>
            <ul class="admin-nav-links">
                <li><a href="/admin" class="active">Visão Geral</a></li>
                <li><a href="/admin/denuncias">Denúncias</a></li>
                <li><a href="/admin/ongs">ONGs</a></li>
                <li><a href="/auth/alterar-senha">Alterar senha</a></li>
                <li>
                    <form action="/auth/logout" method="POST" class="logout-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="logout-button">Sair</button>
                    </form>
                </li>
            </ul>
        </nav>
    </aside>

    <main class="admin-content">
        <header class="admin-header">
            <h1>Painel Administrativo</h1>
            <p>Bem-vindo, <%= user.name %>. Visão global da plataforma, com foco em moderação, volume e operação.</p>
            <nav class="analytics-controls">
                <a href="<%= reportCsvPath || '/admin/relatorio.csv' %>" class="btn btn-outline">
                    <i class="fas fa-file-csv"></i>
                    Exportar CSV
                </a>
                <a href="/impacto" class="btn btn-secondary">
                    <i class="fas fa-chart-line"></i>
                    Ver impacto público
                </a>
            </nav>
        </header>

        <section class="admin-stats">
            <article class="stat-card">
                <header class="stat-header">
                    <i class="fas fa-users"></i>
                    <h3>Usuários</h3>
                </header>
                <nav class="stat-value"><%= totalUsers %></nav>
            </article>

            <article class="stat-card">
                <header class="stat-header">
                    <i class="fas fa-hands-helping"></i>
                    <h3>ONGs</h3>
                </header>
                <nav class="stat-value"><%= totalOngs %></nav>
            </article>

            <article class="stat-card">
                <header class="stat-header">
                    <i class="fas fa-exclamation-circle"></i>
                    <h3>Denúncias</h3>
                </header>
                <nav class="stat-value"><%= totalDenuncias %></nav>
            </article>

            <article class="stat-card">
                <header class="stat-header">
                    <i class="fas fa-clock"></i>
                    <h3>Pendentes</h3>
                </header>
                <nav class="stat-value"><%= denunciasPendentes %></nav>
            </article>

            <article class="stat-card">
                <header class="stat-header">
                    <i class="fas fa-comments"></i>
                    <h3>Respostas</h3>
                </header>
                <nav class="stat-value"><%= totalResponses %></nav>
            </article>

            <article class="stat-card">
                <header class="stat-header">
                    <i class="fas fa-envelope"></i>
                    <h3>Mensagens</h3>
                </header>
                <nav class="stat-value"><%= totalMensagensContato %></nav>
            </article>
        </section>

        <section class="analytics-grid analytics-grid--stacked" aria-labelledby="painel-analitico-admin">
            <article class="analytics-card analytics-card--third">
                <header class="analytics-card__header">
                    <div>
                        <div class="analytics-card__title" id="painel-analitico-admin">
                            <i class="fas fa-chart-pie"></i>
                            Denúncias por status
                        </div>
                        <p class="analytics-card__subtitle">Pendentes, em andamento e resolvidas</p>
                    </div>
                    <span class="analytics-pill"><%= analytics.resolution.rate %>% resolvidas</span>
                </header>
                <div class="analytics-card__body">
                    <canvas id="adminStatusChart" class="analytics-canvas analytics-canvas--small" aria-label="Gráfico de denúncias por status" role="img"></canvas>
                </div>
            </article>

            <article class="analytics-card analytics-card--third">
                <header class="analytics-card__header">
                    <div>
                        <div class="analytics-card__title">
                            <i class="fas fa-chart-line"></i>
                            Linha do tempo
                        </div>
                        <p class="analytics-card__subtitle">Denúncias por dia, semana ou mês</p>
                    </div>
                    <div class="analytics-controls" role="tablist" aria-label="Selecionar período da linha do tempo">
                        <button type="button" class="analytics-toggle is-active" data-admin-timeline="day">Dia</button>
                        <button type="button" class="analytics-toggle" data-admin-timeline="week">Semana</button>
                        <button type="button" class="analytics-toggle" data-admin-timeline="month">Mês</button>
                    </div>
                </header>
                <div class="analytics-card__body">
                    <canvas id="adminTimelineChart" class="analytics-canvas analytics-canvas--small" aria-label="Linha do tempo de denúncias" role="img"></canvas>
                </div>
            </article>

            <article class="analytics-card analytics-card--third">
                <header class="analytics-card__header">
                    <div>
                        <div class="analytics-card__title">
                            <i class="fas fa-layer-group"></i>
                            Categorias mais afetadas
                        </div>
                        <p class="analytics-card__subtitle">Água, esgoto, poluição e outros</p>
                    </div>
                </header>
                <div class="analytics-card__body">
                    <canvas id="adminCategoryChart" class="analytics-canvas analytics-canvas--small" aria-label="Categorias de denúncias" role="img"></canvas>
                </div>
            </article>

            <article class="analytics-card analytics-card--half">
                <header class="analytics-card__header">
                    <div>
                        <div class="analytics-card__title">
                            <i class="fas fa-hands-helping"></i>
                            Respostas por ONG
                        </div>
                        <p class="analytics-card__subtitle">Quem mais respondeu denúncias na plataforma</p>
                    </div>
                    <span class="analytics-pill"><%= analytics.resolution.total %> denúncias</span>
                </header>
                <div class="analytics-card__body">
                    <canvas id="adminResponsesChart" class="analytics-canvas" aria-label="Respostas por ONG" role="img"></canvas>
                </div>
            </article>

            <article class="analytics-card analytics-card--half">
                <header class="analytics-card__header">
                    <div>
                        <div class="analytics-card__title">
                            <i class="fas fa-calendar-alt"></i>
                            Atividade mensal
                        </div>
                        <p class="analytics-card__subtitle">Mensagens, doações e assinaturas por mês</p>
                    </div>
                </header>
                <div class="analytics-card__body">
                    <canvas id="adminMonthlyActivityChart" class="analytics-canvas" aria-label="Atividade mensal da plataforma" role="img"></canvas>
                </div>
            </article>
        </section>

        <section class="admin-actions">
            <article class="action-card">
                <header class="action-header">
                    <i class="fas fa-tasks"></i>
                    <h3>Moderar Denúncias</h3>
                </header>
                <p>Veja o volume global de denúncias, acompanhe o andamento e acesse detalhes rapidamente.</p>
                <a href="/admin/denuncias" class="btn btn-primary">Abrir fila</a>
            </article>

            <article class="action-card">
                <header class="action-header">
                    <i class="fas fa-building"></i>
                    <h3>Gerenciar ONGs</h3>
                </header>
                <p>Audite as ONGs cadastradas, confira vínculos e valide a operação da rede parceira.</p>
                <a href="/admin/ongs" class="btn btn-primary">Ver ONGs</a>
            </article>

            <article class="action-card">
                <header class="action-header">
                    <i class="fas fa-inbox"></i>
                    <h3>Mensagens</h3>
                </header>
                <p>Revise os contatos recebidos pela plataforma e trate solicitações administrativas.</p>
                <a href="/contato" class="btn btn-outline">Abrir contato</a>
            </article>
        </section>

        <section class="admin-logs">
            <article class="admin-log-card">
                <header class="action-header">
                    <i class="fas fa-exclamation-triangle"></i>
                    <h3>Denúncias recentes</h3>
                </header>
                <% if (recentDenuncias && recentDenuncias.length > 0) { %>
                <ul class="admin-list">
                    <% recentDenuncias.forEach((denuncia) => { %>
                    <li>
                        <strong><%= denuncia.title %></strong>
                        <span><%= denuncia.status.replace('_', ' ') %></span>
                    </li>
                    <% }) %>
                </ul>
                <% } else { %>
                <p>Nenhuma denúncia registrada ainda.</p>
                <% } %>
            </article>

            <article class="admin-log-card">
                <header class="action-header">
                    <i class="fas fa-hands-helping"></i>
                    <h3>ONGs recentes</h3>
                </header>
                <% if (recentOngs && recentOngs.length > 0) { %>
                <ul class="admin-list">
                    <% recentOngs.forEach((ong) => { %>
                    <li>
                        <strong><%= ong.name %></strong>
                        <span><%= ong.contact %></span>
                    </li>
                    <% }) %>
                </ul>
                <% } else { %>
                <p>Nenhuma ONG cadastrada ainda.</p>
                <% } %>
            </article>
        </section>
    </main>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script nonce="<%= cspNonce %>">
    window.__ADMIN_ANALYTICS__ = <%- JSON.stringify(analytics).replace(/</g, '\\u003c') %>;
</script>
<script src="/js/analytics/admin-dashboard.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>

<%- include('../partials/footer') %>
