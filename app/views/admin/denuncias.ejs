<%- include('../partials/header') %>

<section class="admin-container">
    <aside class="admin-sidebar">
            <nav class="admin-nav">
                <nav class="admin-nav-header">
                    <h2>Administrador</h2>
                    <p><%= user.name %></p>
                </nav>
            
            <ul class="admin-nav-links">
                <li><a href="/admin">Visão Geral</a></li>
                <li><a href="/admin/denuncias" class="active">Denúncias</a></li>
                <li><a href="/admin/ongs">ONGs</a></li>
                <li><a href="/auth/alterar-senha">Alterar senha</a></li>
                <li>
                    <form action="/auth/logout" method="POST" class="logout-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="logout-button">Sair</button>
                    </form>
                </li>
            </ul>
        </nav>
    </aside>
    
    <main class="admin-content">
        <header class="admin-header">
            <h1>Gerenciar Denúncias</h1>
            <p>Consulte, edite todos os campos ou exclua denúncias registradas.</p>
        </header>

        <% if (success) { %>
        <div class="alert alert-success" role="status"><%= success %></div>
        <% } %>
        <% if (error) { %>
        <div class="alert alert-error" role="alert"><%= error %></div>
        <% } %>
        
        <section class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Título</th>
                        <th>Categoria</th>
                        <th>Status</th>
                        <th>Localização</th>
                        <th>Data</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% denuncias.forEach(denuncia => { %>
                    <tr>
                        <td data-label="ID"><%= denuncia.id %></td>
                        <td data-label="Título"><%= denuncia.title %></td>
                        <td data-label="Categoria">
                            <span class="category-badge category-<%= denuncia.category || 'geral' %>">
                                <%= (denuncia.category || 'geral').charAt(0).toUpperCase() + (denuncia.category || 'geral').slice(1) %>
                            </span>
                        </td>
                        <td data-label="Status">
                            <span class="status status-<%= denuncia.status %>">
                                <%= denuncia.status.replace('_', ' ').charAt(0).toUpperCase() + denuncia.status.replace('_', ' ').slice(1) %>
                            </span>
                        </td>
                        <td data-label="Localização"><%= denuncia.location %></td>
                        <td data-label="Data"><%= new Date(denuncia.createdAt).toLocaleDateString('pt-BR') %></td>
                        <td data-label="Ações">
                            <div class="admin-record-actions">
                                <a href="/denuncias/<%= denuncia.id %>" class="btn btn-sm btn-outline">Ver Detalhes</a>
                                <a href="/admin/denuncias/<%= denuncia.id %>/editar" class="btn btn-sm btn-primary">Editar</a>
                                <form action="/admin/denuncias/<%= denuncia.id %>/excluir" method="POST" onsubmit="return confirm('Excluir definitivamente esta denúncia e as respostas associadas?');">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-sm admin-danger-button">Excluir</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </section>
    </main>
</section>

<%- include('../partials/footer') %>
