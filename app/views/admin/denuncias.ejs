<%- include('../partials/header') %>

<section class="admin-container">
    <aside class="admin-sidebar">
            <nav class="admin-nav">
                <nav class="admin-nav-header">
                    <h2>Administrador</h2>
                    <p><%= user.name %></p>
                </nav>
            
            <ul class="admin-nav-links">
                <li><a href="/admin">Visão Geral</a></li>
                <li><a href="/admin/denuncias" class="active">Denúncias</a></li>
                <li><a href="/admin/ongs">ONGs</a></li>
                <li><a href="/auth/alterar-senha">Alterar senha</a></li>
                <li>
                    <form action="/auth/logout" method="POST" class="logout-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="logout-button">Sair</button>
                    </form>
                </li>
            </ul>
        </nav>
    </aside>
    
    <main class="admin-content">
        <header class="admin-header">
            <h1>Gerenciar Denúncias</h1>
            <p>Consulte, edite todos os campos ou exclua denúncias registradas.</p>
        </header>

        <% if (success) { %>
        <div class="alert alert-success" role="status"><%= success %></div>
        <% } %>
        <% if (error) { %>
        <div class="alert alert-error" role="alert"><%= error %></div>
        <% } %>
        
        <section class="admin-table-container">
            <table class="admin-table admin-denuncias-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Título</th>
                        <th>Categoria</th>
                        <th>Status</th>
                        <th>Localização</th>
                        <th>Data</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% denuncias.forEach(denuncia => { %>
                    <% const categoryRaw = String(denuncia.category || 'geral').trim(); %>
                    <% const categoryNormalized = categoryRaw.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, ''); %>
                    <% const categoryKeyByValue = { agua: 'agua', agua_potavel: 'agua', esgoto: 'esgoto', poluicao: 'poluicao', poluicao_lixo_e_residuos: 'poluicao', lixo: 'poluicao', geral: 'geral', drenagem: 'geral', outros: 'geral', sem_categoria: 'geral' }; %>
                    <% const categoryLabels = { agua: 'Água', esgoto: 'Esgoto', poluicao: 'Poluição', geral: 'Geral' }; %>
                    <% const categoryKey = categoryKeyByValue[categoryNormalized] || 'geral'; %>
                    <% const categoryLabel = categoryKeyByValue[categoryNormalized] ? categoryLabels[categoryKey] : categoryRaw; %>
                    <% const statusKey = String(denuncia.status || 'pendente').trim().toLowerCase().replace(/\s+/g, '_'); %>
                    <% const statusLabels = { pendente: 'Pendente', em_andamento: 'Em andamento', resolvida: 'Resolvida' }; %>
                    <tr>
                        <td data-label="ID"><%= denuncia.id %></td>
                        <td data-label="Título"><%= denuncia.title %></td>
                        <td data-label="Categoria">
                            <span class="category-badge category-<%= categoryKey %>">
                                <%= categoryLabel || 'Geral' %>
                            </span>
                        </td>
                        <td data-label="Status">
                            <span class="status status-<%= statusKey %>">
                                <%= statusLabels[statusKey] || statusKey.replace('_', ' ').replace(/^\w/, character => character.toUpperCase()) %>
                            </span>
                            <form action="/admin/denuncias/<%= denuncia.id %>/status" method="POST" class="admin-status-form">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <label class="admin-action-label">
                                    <span>Alterar status</span>
                                    <select name="status" aria-label="Novo status da denúncia">
                                        <option value="pendente" <%= statusKey === 'pendente' ? 'selected' : '' %>>Pendente</option>
                                        <option value="em_andamento" <%= statusKey === 'em_andamento' ? 'selected' : '' %>>Em andamento</option>
                                        <option value="resolvida" <%= statusKey === 'resolvida' ? 'selected' : '' %>>Resolvida</option>
                                    </select>
                                </label>
                                <button type="submit" class="btn btn-sm btn-primary">Salvar</button>
                            </form>
                        </td>
                        <td data-label="Localização"><%= denuncia.location %></td>
                        <td data-label="Data"><%= new Date(denuncia.createdAt).toLocaleDateString('pt-BR') %></td>
                        <td data-label="Ações">
                            <div class="admin-record-actions">
                                <a href="/denuncias/<%= denuncia.id %>" class="btn btn-sm btn-outline">Ver Detalhes</a>
                                <a href="/admin/denuncias/<%= denuncia.id %>/editar" class="btn btn-sm btn-primary">Editar</a>
                                <details class="admin-reply-details">
                                    <summary class="btn btn-sm btn-outline">Responder</summary>
                                    <form action="/admin/denuncias/<%= denuncia.id %>/responder" method="POST" class="admin-reply-form">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <label>
                                            <span>Resposta pública</span>
                                            <textarea name="responseText" rows="3" maxlength="10000" required></textarea>
                                        </label>
                                        <button type="submit" class="btn btn-sm btn-primary">Publicar resposta</button>
                                    </form>
                                </details>
                                <form action="/admin/denuncias/<%= denuncia.id %>/excluir" method="POST" onsubmit="return confirm('Excluir definitivamente esta denúncia e as respostas associadas?');">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-sm admin-danger-button">Excluir</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </section>
    </main>
</section>

<%- include('../partials/footer') %>
