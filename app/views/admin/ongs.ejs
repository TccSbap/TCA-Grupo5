<%- include('../partials/header') %>

<section class="admin-container">
    <aside class="admin-sidebar">
            <nav class="admin-nav">
                <nav class="admin-nav-header">
                    <h2>Administrador</h2>
                    <p><%= user.name %></p>
                </nav>
            
            <ul class="admin-nav-links">
                <li><a href="/admin">Visão Geral</a></li>
                <li><a href="/admin/denuncias">Denúncias</a></li>
                <li><a href="/admin/ongs" class="active">ONGs</a></li>
                <li><a href="/auth/alterar-senha">Alterar senha</a></li>
                <li>
                    <form action="/auth/logout" method="POST" class="logout-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="logout-button">Sair</button>
                    </form>
                </li>
            </ul>
        </nav>
    </aside>
    
    <main class="admin-content">
        <nav class="admin-header">
            <h1>Gerenciar ONGs</h1>
            <p>Consulte e altere todos os dados administrativos das organizações parceiras.</p>
        </nav>

        <% if (success) { %>
        <div class="alert alert-success" role="status"><%= success %></div>
        <% } %>
        <% if (error) { %>
        <div class="alert alert-error" role="alert"><%= error %></div>
        <% } %>
        
        <section class="admin-ongs-grid">
            <% ongs.forEach(ong => { %>
            <article class="ong-admin-card">
                <nav class="ong-card-header">
                    <h3><%= ong.name %></h3>
                    <span class="admin-record-status <%= ong.isActive === false ? 'is-inactive' : 'is-active' %>"><%= ong.isActive === false ? 'Desativada' : 'Ativa' %></span>
                </nav>
                
                <section class="ong-card-content">
                    <p><strong>Descrição:</strong></p>
                    <p><%= ong.description %></p>
                    
                    <p><strong>Contato:</strong></p>
                    <address><a href="mailto:<%= ong.contact %>"><%= ong.contact %></a></address>

                    <% if (ong.cnpj) { %>
                    <p><strong>CNPJ:</strong></p>
                    <p><%= ong.cnpj %></p>
                    <% } %>

                    <% if (ong.rg) { %>
                    <p><strong>RG do Responsável:</strong></p>
                    <p><%= ong.rg %></p>
                    <% } %>
                    
                    <% if (ong.phone) { %>
                    <p><strong>Telefone:</strong></p>
                    <p><a href="tel:<%= ong.phone %>"><%= ong.phone %></a></p>
                    <% } %>
                    
                    <% if (ong.address) { %>
                    <p><strong>Endereço:</strong></p>
                    <address><%= ong.address %></address>
                    <% } %>
                    
                    <p><strong>Parceira desde:</strong></p>
                    <p><time datetime="<%= ong.createdAt %>"><%= new Date(ong.createdAt).toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' }) %></time></p>
                </section>
                
                <footer class="ong-card-footer">
                    <% if (ong.isActive !== false) { %>
                    <a href="/ongs/<%= ong.id %>" class="btn btn-outline">Ver Detalhes</a>
                    <% } %>
                    <a href="/admin/ongs/<%= ong.id %>/editar" class="btn btn-primary">Editar</a>
                    <% if (ong.isActive === false) { %>
                    <form action="/admin/ongs/<%= ong.id %>/reativar" method="POST" onsubmit="return confirm('Reativar esta ONG e torná-la pública novamente?');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-outline">Reativar</button>
                    </form>
                    <% } else { %>
                    <form action="/admin/ongs/<%= ong.id %>/excluir" method="POST" onsubmit="return confirm('Desativar esta ONG? Ela deixará de aparecer publicamente e poderá ser reativada depois.');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn admin-danger-button">Excluir</button>
                    </form>
                    <% } %>
                </footer>
            </article>
            <% }) %>
        </section>
    </main>
</section>

<%- include('../partials/footer') %>
