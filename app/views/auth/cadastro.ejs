<%- include("../partials/header") %>

<section class="auth-section">
    <section class="container">
        <nav class="auth-container">
            <article class="auth-card">
                <header class="auth-header">
                    <h1>Criar Conta</h1>
                    <p>Cadastre-se para fazer denúncias ou registrar sua ONG</p>
                </header>

                <% if (error) { %>
                <nav class="alert alert-error">
                    <i class="fas fa-exclamation-circle"></i>
                    <%= error %>
                </nav>
                <% } %>

                <form class="auth-form" method="POST" action="/auth/cadastro" id="cadastroForm" novalidate data-submit-lock-mode="manual">
                    <nav class="form-group">
                        <label for="userType">Perfil de Acesso</label>
                        <select id="userType" name="userType">
                            <option value="user">Usuário Normal</option>
                            <option value="ong">ONG</option>
                        </select>
                    </nav>

                    <nav class="form-group">
                        <label for="name">Nome Completo</label>
                        <input type="text" id="name" name="name" required>
                        <nav class="error-message" id="name-error"></nav>
                    </nav>

                    <nav class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" required>
                        <nav class="error-message" id="email-error"></nav>
                    </nav>

                    <nav class="form-group">
                        <label for="password">Senha</label>
                        <div class="password-field">
                            <input type="password" id="password" name="password" required autocomplete="new-password">
                            <button
                                type="button"
                                class="password-toggle"
                                data-password-toggle="password"
                                aria-label="Mostrar senha"
                                aria-pressed="false"
                                aria-controls="password"
                            >
                                <i class="fas fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <nav class="error-message" id="password-error"></nav>
                    </nav>

                    <nav class="form-group">
                        <label for="confirmPassword">Confirmar Senha</label>
                        <div class="password-field">
                            <input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password">
                            <button
                                type="button"
                                class="password-toggle"
                                data-password-toggle="confirmPassword"
                                aria-label="Mostrar senha"
                                aria-pressed="false"
                                aria-controls="confirmPassword"
                            >
                                <i class="fas fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <nav class="error-message" id="confirmPassword-error"></nav>
                    </nav>

                    <!-- Campos específicos para ONGs -->
                    <section id="ongFields" style="display: none;">
                        <h3>Informações da ONG</h3>

                        <nav class="form-group">
                            <label for="ongName">Nome da ONG</label>
                            <input type="text" id="ongName" name="ongName">
                            <nav class="error-message" id="ongName-error"></nav>
                        </nav>

                        <nav class="form-group">
                            <label for="ongDescription">Descrição da ONG</label>
                            <textarea id="ongDescription" name="ongDescription" rows="3"></textarea>
                            <nav class="error-message" id="ongDescription-error"></nav>
                        </nav>

                        <nav class="form-group">
                            <label for="ongContact">Email de Contato</label>
                            <input type="email" id="ongContact" name="ongContact">
                            <nav class="error-message" id="ongContact-error"></nav>
                        </nav>

                        <nav class="form-group">
                            <label for="ongCnpj">CNPJ da ONG</label>
                            <input type="text" id="ongCnpj" name="ongCnpj" data-mask="cnpj" inputmode="numeric" placeholder="00.000.000/0000-00">
                            <nav class="error-message" id="ongCnpj-error"></nav>
                        </nav>

                        <nav class="form-group">
                            <label for="ongRg">RG do Responsável</label>
                            <input type="text" id="ongRg" name="ongRg" data-mask="rg" inputmode="numeric" placeholder="00.000.000-0">
                            <nav class="error-message" id="ongRg-error"></nav>
                        </nav>

                        <nav class="form-group">
                            <label for="ongPhone">Telefone</label>
                            <input type="tel" id="ongPhone" name="ongPhone" data-mask="telefone" inputmode="numeric" placeholder="(00) 00000-0000">
                            <nav class="error-message" id="ongPhone-error"></nav>
                        </nav>

                        <nav class="form-group">
                            <label for="ongAddress">Endereço</label>
                            <input type="text" id="ongAddress" name="ongAddress">
                            <nav class="error-message" id="ongAddress-error"></nav>
                        </nav>
                    </section>

                    <button type="submit" class="btn btn-primary btn-full">
                        <i class="fas fa-user-plus"></i>
                        Criar Conta
                    </button>
                </form>

                <footer class="auth-footer">
                    <p>Já tem uma conta? <a href="/auth/login">Entre aqui</a></p>
                </footer>
            </article>
        </nav>
    </section>
</section>

<script src="/js/validation.js"></script>
<script src="/js/cadastro.js"></script>

<%- include("../partials/footer") %>
