<%- include('../partials/header') %>
<section class="denuncia-details"><section class="container">
    <header class="details-header"><nav class="breadcrumb"><a href="/denuncias">Den&uacute;ncias</a><span>/</span><span>Detalhes</span></nav>
        <header class="details-title"><h1><%= denuncia.title %></h1><span class="status status-<%= denuncia.status %>"><%= denuncia.status.replace('_', ' ').charAt(0).toUpperCase() + denuncia.status.replace('_', ' ').slice(1) %></span></header>
    </header>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <section class="details-content"><article class="main-content"><section class="denuncia-info">
        <h2>Informa&ccedil;&otilde;es da den&uacute;ncia</h2><div class="info-grid">
            <div class="info-item"><label>Categoria:</label><span><%= (denuncia.category || 'geral').charAt(0).toUpperCase() + (denuncia.category || 'geral').slice(1) %></span></div>
            <div class="info-item"><label>Localiza&ccedil;&atilde;o:</label><span><%= denuncia.location %></span></div>
            <div class="info-item"><label>Denunciante:</label><span><%= denuncia.userName %></span></div>
            <div class="info-item"><label>Data:</label><span><%= new Date(denuncia.createdAt).toLocaleDateString('pt-BR') %></span></div>
        </div><section class="description"><h3>Descri&ccedil;&atilde;o</h3><p><%= denuncia.description %></p></section>
    </section></article><aside class="sidebar"><section class="actions-card"><h3>A&ccedil;&otilde;es</h3><a href="/denuncias" class="btn btn-outline btn-full">Voltar para den&uacute;ncias</a></section>
    <section class="info-card"><h3>Sobre o encaminhamento</h3><p>As den&uacute;ncias devem ser encaminhadas aos &oacute;rg&atilde;os p&uacute;blicos competentes. As ONGs podem oferecer orienta&ccedil;&atilde;o e apoio &agrave;s comunidades.</p></section></aside></section>
</section></section>
<%- include('../partials/footer') %>
