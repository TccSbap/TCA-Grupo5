<%- include('../partials/header') %>

<section class="form-section">
    <section class="container">
        <article class="form-container">
            <header class="form-header">
                <h1>Nova Denúncia</h1>
                <p>Relate problemas de saneamento básico em sua região</p>
            </header>
            
            <% if (typeof error !== 'undefined' && error) { %>
            <nav class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i>
                <%= error %>
            </nav>
            <% } %>
            
            <% if (typeof success !== 'undefined' && success) { %>
            <nav class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                <%= success %>
            </nav>
            <% } %>
            
            <form class="denuncia-form" method="POST" action="/denuncias/nova" novalidate>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <nav class="form-group">
                    <label for="title">Título da Denúncia *</label>
                    <input type="text" id="title" name="title" required 
                           placeholder="Ex: Esgoto a céu aberto na Rua das Flores">
                </nav>
                
                <nav class="form-group">
                    <label for="category">Categoria</label>
                    <select id="category" name="category">
                        <option value="esgoto">Esgoto</option>
                        <option value="agua">Água</option>
                        <option value="poluicao">Poluição, lixo e resíduos</option>
                        <option value="geral">Outros problemas de saneamento e drenagem</option>
                    </select>
                </nav>
                
                <nav class="form-group">
                    <label for="cep">CEP</label>
                    <input type="text" id="cep" name="cep" maxlength="9"
                           placeholder="Ex: 01001-000">
                    <small>Digite o CEP para preencher o endereço automaticamente</small>
                </nav>

                <nav class="form-group">
                    <label for="location">Localização *</label>
                    <input type="text" id="location" name="location" required 
                           placeholder="Ex: Rua das Flores, 123 - Centro - São Paulo/SP">
                    <small>Seja o mais específico possível para facilitar a localização</small>
                </nav>
                
                <section class="form-group report-location-picker" aria-labelledby="report-location-title">
                    <h2 id="report-location-title">Marque a região aproximada no mapa</h2>
                    <p>Opcional. Aproxime o mapa com os controles +/− ou o scroll para localizar ruas e bairros. O ponto será arredondado para uma área de cerca de 2 km e agrupado com outras denúncias.</p>
                    <div id="denuncia-location-map" class="interactive-map" role="application" aria-label="Mapa para selecionar a região aproximada da denúncia"></div>
                    <small class="map-attribution"><a href="https://openfreemap.org/" target="_blank" rel="noopener noreferrer">OpenFreeMap</a> © <a href="https://openmaptiles.org/" target="_blank" rel="noopener noreferrer">OpenMapTiles</a> · Dados de <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a></small>
                    <input type="hidden" id="latitude" name="latitude">
                    <input type="hidden" id="longitude" name="longitude">
                    <p id="location-map-status" class="map-status" role="status" aria-live="polite">Nenhum ponto selecionado. Clique no mapa ou use sua localização.</p>
                    <div class="map-actions">
                        <button class="btn btn-outline" type="button" id="use-my-location">Usar minha localização</button>
                        <button class="btn btn-outline" type="button" id="clear-map-location" disabled>Remover ponto</button>
                    </div>
                </section>
                <nav class="form-group">
                    <label for="description">Descrição Detalhada *</label>
                    <textarea id="description" name="description" rows="6" required 
                              placeholder="Descreva detalhadamente o problema: quando começou, qual a gravidade, quantas pessoas são afetadas, etc."></textarea>
                    <small>Forneça o máximo de detalhes possível para ajudar na resolução</small>
                </nav>
                
                <footer class="form-actions">
                    <a href="/denuncias" class="btn btn-outline">Cancelar</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane"></i>
                        Enviar Denúncia
                    </button>
                </footer>
            </form>

<script src="/js/forms/denuncia-form.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
<script type="module" src="/js/denuncias/nova.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>

            <aside class="form-info">
                <h3>Informações Importantes</h3>
                <ul>
                    <li><i class="fas fa-shield-alt"></i> Suas informações pessoais são protegidas</li>
                    <li><i class="fas fa-eye"></i> Sua denúncia será visível para ONGs parceiras</li>
                    <li><i class="fas fa-bell"></i> Acompanhe seus registros no dashboard</li>
                    <li><i class="fas fa-clock"></i> A resolu&ccedil;&atilde;o cabe aos &oacute;rg&atilde;os p&uacute;blicos competentes</li>
                </ul>
            </aside>
        </article>
    </section>
</section>

<%- include('../partials/footer') %>
