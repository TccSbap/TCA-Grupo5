<%- include("./partials/header", { extraStyles: ["/stylesheets/form.css"] }) %>

<% const projectDonation = typeof isProjectDonation !== 'undefined' && isProjectDonation; %>
<section class="form-page">
    <section class="container">
        <header class="page-header">
            <h1>Doar para <%= projectDonation ? projectRecipientName : ong.name %></h1>
            <p>Sua contribui&ccedil;&atilde;o &eacute; muito importante para <%= projectDonation ? 'manter o funcionamento da plataforma' : ong.name %>!</p>
        </header>
        <p class="alert alert-info">Voc&ecirc; ser&aacute; direcionado ao checkout seguro do Mercado Pago para concluir a doa&ccedil;&atilde;o. O valor ser&aacute; recebido pela <%= projectDonation ? 'conta geral do projeto' : 'conta Mercado Pago conectada da ONG' %>.</p>

        <% if (typeof error !== 'undefined' && error) { %>
            <section class="alert alert-error" role="alert">
                <p><%= error %></p>
            </section>
        <% } %>

        <form action="/doar" method="POST" class="styled-form" id="doacaoForm" novalidate data-submit-lock-mode="manual">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="recipientType" value="<%= projectDonation ? 'projeto' : 'ong' %>">
            <% if (!projectDonation) { %><input type="hidden" name="ongId" value="<%= ong.id %>"><% } %>

            <h2>1. Informações do Doador</h2>
            <nav class="form-group">
                <label for="nomeCompleto">Nome Completo</label>
                <input type="text" id="nomeCompleto" name="nomeCompleto" placeholder="Seu nome completo" required aria-describedby="nomeCompleto-error">
                <nav class="error-message" id="nomeCompleto-error" aria-live="polite"></nav>
            </nav>

            <nav class="form-group">
                <label for="emailDoador">E-mail</label>
                <input type="email" id="emailDoador" name="emailDoador" placeholder="seu@email.com" required aria-describedby="emailDoador-error">
                <nav class="error-message" id="emailDoador-error" aria-live="polite"></nav>
            </nav>

            <nav class="form-group">
                <label for="telefoneDoador">Telefone</label>
                <input type="tel" id="telefoneDoador" name="telefoneDoador" data-mask="telefone" inputmode="numeric" placeholder="(00) 00000-0000" required aria-describedby="telefoneDoador-error">
                <nav class="error-message" id="telefoneDoador-error" aria-live="polite"></nav>
            </nav>

            <nav class="form-group">
                <label for="documentoDoador">CPF</label>
                <input type="text" id="documentoDoador" name="documentoDoador" data-mask="cpf" inputmode="numeric" placeholder="000.000.000-00" required aria-describedby="documentoDoador-error">
                <nav class="error-message" id="documentoDoador-error" aria-live="polite"></nav>
            </nav>

            <nav class="form-group">
                <label for="cepDoador">CEP</label>
                <input type="text" id="cepDoador" name="cepDoador" inputmode="numeric" maxlength="9" placeholder="00000-000" required aria-describedby="cepDoador-error">
                <nav class="error-message" id="cepDoador-error" aria-live="polite"></nav>
            </nav>

            <nav class="form-group">
                <label for="ruaDoador">Rua</label>
                <input type="text" id="ruaDoador" name="ruaDoador" placeholder="Rua" required aria-describedby="ruaDoador-error">
                <nav class="error-message" id="ruaDoador-error" aria-live="polite"></nav>
            </nav>

            <nav class="form-group">
                <label for="numeroDoador">Número</label>
                <input type="text" id="numeroDoador" name="numeroDoador" placeholder="Número" required aria-describedby="numeroDoador-error">
                <nav class="error-message" id="numeroDoador-error" aria-live="polite"></nav>
            </nav>

            <nav class="form-group">
                <label for="bairroDoador">Bairro</label>
                <input type="text" id="bairroDoador" name="bairroDoador" placeholder="Bairro" required aria-describedby="bairroDoador-error">
                <nav class="error-message" id="bairroDoador-error" aria-live="polite"></nav>
            </nav>

            <nav class="form-group">
                <label for="cidadeDoador">Cidade</label>
                <input type="text" id="cidadeDoador" name="cidadeDoador" placeholder="Cidade" required aria-describedby="cidadeDoador-error">
                <nav class="error-message" id="cidadeDoador-error" aria-live="polite"></nav>
            </nav>

            <nav class="form-group">
                <label for="estadoDoador">Estado</label>
                <input type="text" id="estadoDoador" name="estadoDoador" maxlength="2" placeholder="UF" required aria-describedby="estadoDoador-error">
                <nav class="error-message" id="estadoDoador-error" aria-live="polite"></nav>
            </nav>

            <h2>2. Detalhes da Doação</h2>
            <nav class="form-group">
                <label for="valorDoacao">Valor da Doação</label>
                <nav class="donation-amount-options">
                    <button type="button" class="btn btn-secondary" data-value="10">R$ 10</button>
                    <button type="button" class="btn btn-secondary" data-value="40">R$ 40</button>
                    <button type="button" class="btn btn-secondary" data-value="80">R$ 80</button>
                    <button type="button" class="btn btn-secondary" data-value="120">R$ 120</button>
                </nav>
                <input type="number" id="valorDoacao" name="valorDoacao" min="5" step="any" placeholder="Outro valor (mínimo R$ 5,00)" required aria-describedby="valorDoacao-error">
                <nav class="error-message" id="valorDoacao-error" aria-live="polite"></nav>
            </nav>

            <nav class="form-group">
                <label for="mensagemOpcional"><%= projectDonation ? 'Mensagem (opcional)' : 'Mensagem para a ONG (opcional)' %></label>
                <textarea id="mensagemOpcional" name="mensagemOpcional" rows="4" placeholder="<%= projectDonation ? 'Deixe uma mensagem, se desejar.' : 'Quer deixar uma mensagem para a ONG?' %>"></textarea>
            </nav>

            <p>As formas de pagamento disponíveis aparecerão no checkout do Mercado Pago.</p>

            <h2>3. Confirmação</h2>
            <nav class="form-group">
                <label>
                    <input type="checkbox" id="confirmacao" name="confirmacao" required aria-describedby="confirmacao-error">
                    Confirmo os dados e entendo que serei redirecionado ao Mercado Pago para concluir o pagamento.
                </label>
                <nav class="error-message" id="confirmacao-error" aria-live="polite"></nav>
            </nav>

            <button type="submit" class="btn btn-primary" data-mp-checkout-cta="checkout-pro">Continuar para pagamento no Mercado Pago</button>
            <% if (!projectDonation) { %><a class="btn btn-outline" href="/ongs/<%= ong.id %>">Ver contato da ONG</a><% } %>
        </form>
    </section>
</section>

<script src="/js/validation.js"></script>
<script src="/js/forms/doacao-form.js"></script>
<%- include("./partials/footer") %>
