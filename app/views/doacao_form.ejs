<%- include("./partials/header", { extraStyles: ["/stylesheets/form.css"] }) %>

<section class="form-page">
    <section class="container">
        <header class="page-header">
            <h1>Doar para <%= ong.name %></h1>
            <p>Sua contribuição é muito importante para <%= ong.name %>!</p>
        </header>
        <p class="alert alert-info">Este formulário registra sua intenção de apoiar a ONG. Nenhum pagamento é processado pelo site. Combine a contribuição diretamente com a organização pelos canais do seu perfil.</p>

        <% if (typeof error !== 'undefined' && error) { %>
            <section class="alert alert-error" role="alert">
                <p><%= error %></p>
            </section>
        <% } %>

        <form action="/doar" method="POST" class="styled-form" id="doacaoForm" novalidate data-submit-lock-mode="manual">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="ongId" value="<%= ong.id %>">

            <h2>1. Informações do Doador</h2>
            <nav class="form-group">
                <label for="nomeCompleto">Nome Completo</label>
                <input type="text" id="nomeCompleto" name="nomeCompleto" placeholder="Seu nome completo">
                <nav class="error-message" id="nomeCompleto-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="emailDoador">E-mail</label>
                <input type="email" id="emailDoador" name="emailDoador" placeholder="seu@email.com">
                <nav class="error-message" id="emailDoador-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="telefoneDoador">Telefone</label>
                <input type="tel" id="telefoneDoador" name="telefoneDoador" data-mask="telefone" inputmode="numeric" placeholder="(00) 00000-0000">
                <nav class="error-message" id="telefoneDoador-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="documentoDoador">CPF</label>
                <input type="text" id="documentoDoador" name="documentoDoador" data-mask="cpf" inputmode="numeric" placeholder="000.000.000-00">
                <nav class="error-message" id="documentoDoador-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="cepDoador">CEP</label>
                <input type="text" id="cepDoador" name="cepDoador" placeholder="XXXXX-XXX">
                <nav class="error-message" id="cepDoador-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="ruaDoador">Rua</label>
                <input type="text" id="ruaDoador" name="ruaDoador" placeholder="Rua">
                <nav class="error-message" id="ruaDoador-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="numeroDoador">Número</label>
                <input type="text" id="numeroDoador" name="numeroDoador" placeholder="Número">
                <nav class="error-message" id="numeroDoador-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="bairroDoador">Bairro</label>
                <input type="text" id="bairroDoador" name="bairroDoador" placeholder="Bairro">
                <nav class="error-message" id="bairroDoador-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="cidadeDoador">Cidade</label>
                <input type="text" id="cidadeDoador" name="cidadeDoador" placeholder="Cidade">
                <nav class="error-message" id="cidadeDoador-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="estadoDoador">Estado</label>
                <input type="text" id="estadoDoador" name="estadoDoador" placeholder="Estado">
                <nav class="error-message" id="estadoDoador-error"></nav>
            </nav>

            <h2>2. Detalhes da Doação</h2>
            <nav class="form-group">
                <label>Valor da Doação</label>
                <nav class="donation-amount-options">
                    <button type="button" class="btn btn-secondary" data-value="10">R$ 10</button>
                    <button type="button" class="btn btn-secondary" data-value="40">R$ 40</button>
                    <button type="button" class="btn btn-secondary" data-value="80">R$ 80</button>
                    <button type="button" class="btn btn-secondary" data-value="120">R$ 120</button>
                </nav>
                <input type="number" id="valorDoacao" name="valorDoacao" min="5" step="any" placeholder="Outro valor (mínimo R$ 5,00)">
                <nav class="error-message" id="valorDoacao-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="mensagemOpcional">Mensagem para a ONG (opcional)</label>
                <textarea id="mensagemOpcional" name="mensagemOpcional" rows="4" placeholder="Quer deixar uma mensagem para a ONG?"></textarea>
            </nav>

            <h2>3. Forma de apoio preferida</h2>
            <nav class="form-group">
                <label>Método preferido para combinar com a ONG</label>
                <nav class="payment-methods">
                    <label><input type="radio" name="metodoPagamento" value="cartao"> Cartão de Crédito</label>
                    <label><input type="radio" name="metodoPagamento" value="pix"> Pix</label>
                    <label><input type="radio" name="metodoPagamento" value="boleto"> Boleto</label>
                </nav>
                <nav class="error-message" id="metodoPagamento-error"></nav>
            </nav>

            <h2>4. Confirmação</h2>
            <nav class="form-group">
                <label>
                    <input type="checkbox" id="confirmacao" name="confirmacao" required>
                    Confirmo os dados e entendo que este registro não realiza pagamento.
                </label>
                <nav class="error-message" id="confirmacao-error"></nav>
            </nav>

            <button type="submit" class="btn btn-primary">Finalizar Doação</button>
            <a class="btn btn-outline" href="/ongs/<%= ong.id %>">Ver contato da ONG</a>
        </form>
    </section>
</section>

<script src="/js/validation.js"></script>
<script src="/js/forms/doacao-form.js"></script>
<%- include("./partials/footer") %>
