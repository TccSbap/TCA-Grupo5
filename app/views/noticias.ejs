<%- include('partials/header') %>

<section class="noticias-hero">
    <article class="noticias-hero-content">
        <h1>Notícias sobre Saneamento Básico</h1>
        <p>Acompanhe as últimas notícias e atualizações sobre saneamento básico e água potável no Brasil</p>
    </article>
</section>

<section class="noticias-container">
    <article class="noticias-grid">
        <% noticias.forEach(noticia => { %>
            <article class="noticia-card">
                <figure class="noticia-image">
                    <img src="<%= noticia.image %>" alt="<%= noticia.title %>">
                </figure>
                
                <header class="noticia-header">
                    <time datetime="<%= noticia.date %>"><%= noticia.date %></time>
                    <h2><%= noticia.title %></h2>
                </header>
                
                <section class="noticia-content">
                    <p><%= noticia.description %></p>
                </section>
                
                <footer class="noticia-footer">
                    <a href="<%= noticia.url %>" class="btn btn-primary" target="_blank">Ler Mais</a>
                </footer>
            </article>
        <% }) %>
    </article>
</section>

<%- include('partials/footer') %>

