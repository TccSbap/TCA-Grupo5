<%- include("../partials/header") %>

<section class="ong-details-section">
    <section class="container">
        <header class="section-header">
            <h1><%= ong.name %></h1>
        </header>

        <address class="ong-info-card card">
            <h2>Informa&ccedil;&otilde;es da organiza&ccedil;&atilde;o</h2>
            <% if (ong.contact) { %><div class="info-item"><i class="fas fa-envelope"></i><span><%= ong.contact %></span></div><% } %>
            <% if (ong.phone) { %><div class="info-item"><i class="fas fa-phone"></i><span><%= ong.phone %></span></div><% } %>
            <% if (ong.address) { %><div class="info-item"><i class="fas fa-map-marker-alt"></i><span><%= ong.address %></span></div><% } %>
            <% if (ong.createdAt) { %><div class="info-item"><i class="fas fa-calendar"></i><span>Parceira desde <%= new Date(ong.createdAt).toLocaleDateString("pt-BR", { month: "long", year: "numeric" }) %></span></div><% } %>
        </address>
    </section>
</section>

<%- include("../partials/footer") %>
