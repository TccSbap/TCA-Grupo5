<%- include('../partials/header') %>

<section class="admin-section analytics-page">
    <section class="container">
        <header class="analytics-hero">
            <h1>Estatísticas da ONG</h1>
            <p>Resumo analítico da <%= ong.name %> com foco em respostas, tempo de atendimento e volume de atuação por período.</p>
            <nav class="analytics-controls">
                <a href="<%= reportCsvPath || '/ongs/admin/relatorio.csv' %>" class="btn btn-outline">
                    <i class="fas fa-file-csv"></i>
                    Exportar relatório
                </a>
                <a href="/ongs/admin/dashboard" class="btn btn-secondary">
                    <i class="fas fa-layer-group"></i>
                    Painel operacional
                </a>
            </nav>
        </header>

        <section class="analytics-kpis">
            <article class="analytics-kpi">
                <div class="analytics-kpi__label"><i class="fas fa-comments"></i> Respostas registradas</div>
                <div class="analytics-kpi__value"><%= stats.totalResponses %></div>
                <div class="analytics-kpi__meta">Total de respostas feitas pela ONG</div>
            </article>

            <article class="analytics-kpi">
                <div class="analytics-kpi__label"><i class="fas fa-check-circle"></i> Casos resolvidos</div>
                <div class="analytics-kpi__value"><%= stats.resolvedByOng %></div>
                <div class="analytics-kpi__meta">Casos concluídos com sucesso</div>
            </article>

            <article class="analytics-kpi">
                <div class="analytics-kpi__label"><i class="fas fa-clock"></i> Denúncias pendentes</div>
                <div class="analytics-kpi__value"><%= stats.pendingDenuncias %></div>
                <div class="analytics-kpi__meta">Fila geral disponível para resposta</div>
            </article>

            <article class="analytics-kpi">
                <div class="analytics-kpi__label"><i class="fas fa-percentage"></i> Taxa de resolução</div>
                <div class="analytics-kpi__value"><%= stats.resolutionRate %>%</div>
                <div class="analytics-kpi__meta">Efetividade sobre as denúncias respondidas</div>
            </article>

            <article class="analytics-kpi">
                <div class="analytics-kpi__label"><i class="fas fa-hourglass-half"></i> Tempo médio de 1ª resposta</div>
                <div class="analytics-kpi__value"><%= stats.avgFirstResponseLabel %></div>
                <div class="analytics-kpi__meta">Média até a primeira interação da ONG</div>
            </article>

            <article class="analytics-kpi">
                <div class="analytics-kpi__label"><i class="fas fa-folder-open"></i> Casos em aberto</div>
                <div class="analytics-kpi__value"><%= stats.openCases %></div>
                <div class="analytics-kpi__meta">Casos já tocados, mas ainda não resolvidos</div>
            </article>
        </section>

        <section class="analytics-grid">
            <article class="analytics-card analytics-card--half">
                <header class="analytics-card__header">
                    <div>
                        <div class="analytics-card__title">
                            <i class="fas fa-chart-bar"></i>
                            Pendências por tipo de problema
                        </div>
                        <p class="analytics-card__subtitle">Ajuda a enxergar onde está a maior concentração de demanda</p>
                    </div>
                </header>
                <div class="analytics-card__body">
                    <canvas id="ongPendingByCategoryChart" class="analytics-canvas analytics-canvas--small" aria-label="Denúncias pendentes por categoria" role="img"></canvas>
                </div>
            </article>

            <article class="analytics-card analytics-card--half">
                <header class="analytics-card__header">
                    <div>
                        <div class="analytics-card__title">
                            <i class="fas fa-chart-line"></i>
                            Volume de respostas por mês
                        </div>
                        <p class="analytics-card__subtitle">Histórico de respostas da ONG ao longo do tempo</p>
                    </div>
                </header>
                <div class="analytics-card__body">
                    <canvas id="ongResponsesVolumeChart" class="analytics-canvas analytics-canvas--small" aria-label="Volume de respostas por mês" role="img"></canvas>
                </div>
            </article>
        </section>

        <section class="impact-strip" style="margin-top: var(--spacing-6);">
            <div>
                <h2>Por que isso importa</h2>
                <p>Esses indicadores ajudam a ONG a priorizar o que é urgente, medir velocidade de atendimento e mostrar evolução para parceiros e apoiadores.</p>
            </div>
            <div class="impact-strip__actions">
                <a href="/ongs/admin/dashboard" class="btn btn-primary">Voltar ao painel operacional</a>
                <a href="/ongs" class="btn btn-outline">Ver ONGs parceiras</a>
            </div>
        </section>
    </section>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script nonce="<%= cspNonce %>">
    window.__ONG_STATS_ANALYTICS__ = <%- JSON.stringify({ analytics, stats }).replace(/</g, '\\u003c') %>;
</script>
<script src="/js/analytics/ong-stats.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>

<%- include('../partials/footer') %>
