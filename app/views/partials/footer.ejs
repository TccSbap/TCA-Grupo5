        <nav class="container">
            <nav class="footer-content">
                <nav class="footer-section">
                    <h3>ODS 6 - Água Limpa e Saneamento</h3>
                    <p>Plataforma dedicada a promover o acesso universal à água potável e saneamento básico através de denúncias e ações colaborativas.</p>
                </nav>
                
                <nav class="footer-section">
                    <h4>Links Úteis</h4>
                    <ul>
                        <li><a href="/noticias">Notícias</a></li>
                        <li><a href="/ongs">ONGs Parceiras</a></li>
                        <li><a href="/impacto">Impacto da plataforma</a></li>
                        <li><a href="/denuncias/nova">Registrar denúncia</a></li>
                        <li><a href="/sobre">Sobre a plataforma</a></li>
                        <li><a href="/contato">Contato</a></li>
                        <li><a href="/doacoes">Doar</a></li>
                        <li><a href="/privacidade">Privacidade e Cookies</a></li>
                    </ul>
                </nav>
                
                <nav class="footer-section">
                    <h4>Contato</h4>
                    <ul>
                        <li><i class="fas fa-envelope"></i> contato@ods6.org</li>
                        <li><i class="fas fa-phone"></i> (11) 9999-9999</li>
                        <li><i class="fas fa-map-marker-alt"></i> São Paulo, SP</li>
                    </ul>
                </nav>
                
                <nav class="footer-section">
                    <h4>Redes Sociais</h4>
                    <nav class="social-links">
                        <a href="https://facebook.com" target="_blank"><i class="fab fa-facebook"></i></a>
                        <a href="https://twitter.com" target="_blank"><i class="fab fa-twitter"></i></a>
                        <a href="https://instagram.com" target="_blank"><i class="fab fa-instagram"></i></a>
                        <a href="https://wa.me" target="_blank"><i class="fab fa-whatsapp"></i></a>
                    </nav>
