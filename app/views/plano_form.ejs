<%- include("./partials/header") %>
<link rel="stylesheet" href="/stylesheets/form.css">

<section class="form-page">
    <section class="container">
        <header class="page-header">
            <h1>Assinar Plano: <%= plano.title %></h1>
            <p>Preencha os dados para assinar o plano e impulsionar sua ONG!</p>
        </header>

        <% if (typeof error !== 'undefined' && error) { %>
            <section class="alert alert-error" role="alert">
                <p><%= error %></p>
            </section>
        <% } %>

        <form action="/assinar-plano" method="POST" class="styled-form" id="planoForm" novalidate data-submit-lock-mode="manual">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="planoId" value="<%= plano.id %>">
            <input type="hidden" name="planoNome" value="<%= plano.title %>">
            <input type="hidden" name="planoPreco" value="<%= plano.price %>">

            <h2>1. Informações do Comprador</h2>
            <nav class="form-group">
                <label for="nomeCompleto">Nome Completo</label>
                <input type="text" id="nomeCompleto" name="nomeCompleto" placeholder="Seu nome completo">
                <nav class="error-message" id="nomeCompleto-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="emailComprador">E-mail</label>
                <input type="email" id="emailComprador" name="emailComprador" placeholder="seu@email.com">
                <nav class="error-message" id="emailComprador-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="telefoneComprador">Telefone</label>
                <input type="tel" id="telefoneComprador" name="telefoneComprador" data-mask="telefone" inputmode="numeric" placeholder="(00) 00000-0000">
                <nav class="error-message" id="telefoneComprador-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="documentoComprador">CPF</label>
                <input type="text" id="documentoComprador" name="documentoComprador" data-mask="cpf" inputmode="numeric" placeholder="000.000.000-00">
                <nav class="error-message" id="documentoComprador-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="cepComprador">CEP</label>
                <input type="text" id="cepComprador" name="cepComprador" placeholder="XXXXX-XXX">
                <nav class="error-message" id="cepComprador-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="ruaComprador">Rua</label>
                <input type="text" id="ruaComprador" name="ruaComprador" placeholder="Rua">
                <nav class="error-message" id="ruaComprador-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="numeroComprador">Número</label>
                <input type="text" id="numeroComprador" name="numeroComprador" placeholder="Número">
                <nav class="error-message" id="numeroComprador-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="bairroComprador">Bairro</label>
                <input type="text" id="bairroComprador" name="bairroComprador" placeholder="Bairro">
                <nav class="error-message" id="bairroComprador-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="cidadeComprador">Cidade</label>
                <input type="text" id="cidadeComprador" name="cidadeComprador" placeholder="Cidade">
                <nav class="error-message" id="cidadeComprador-error"></nav>
            </nav>

            <nav class="form-group">
                <label for="estadoComprador">Estado</label>
                <input type="text" id="estadoComprador" name="estadoComprador" placeholder="Estado">
                <nav class="error-message" id="estadoComprador-error"></nav>
            </nav>

            <h2>2. Detalhes do Plano</h2>
            <p>Você está assinando o **<%= plano.title %>** por **<%= plano.price %>**.</p>

            <h2>3. Forma de Pagamento</h2>
            <nav class="form-group">
                <label>Método de Pagamento</label>
                <nav class="payment-methods">
                    <label><input type="radio" name="metodoPagamento" value="cartao"> Cartão de Crédito</label>
                    <label><input type="radio" name="metodoPagamento" value="pix"> Pix</label>
                    <label><input type="radio" name="metodoPagamento" value="boleto"> Boleto</label>
                </nav>
                <nav class="error-message" id="metodoPagamento-error"></nav>
            </nav>

            <nav id="cartao-fields" class="payment-fields" style="display: none;">
                <nav class="form-group">
                    <label for="numeroCartao">Número do Cartão</label>
                    <input type="text" id="numeroCartao" name="numeroCartao" placeholder="XXXX XXXX XXXX XXXX">
                    <nav class="error-message" id="numeroCartao-error"></nav>
                </nav>
                <nav class="form-group-inline">
                    <nav class="form-group">
                        <label for="validadeCartao">Validade</label>
                        <input type="text" id="validadeCartao" name="validadeCartao" placeholder="MM/AA">
                        <nav class="error-message" id="validadeCartao-error"></nav>
                    </nav>
                    <nav class="form-group">
                        <label for="cvvCartao">CVV</label>
                        <input type="text" id="cvvCartao" name="cvvCartao" placeholder="XXX">
                        <nav class="error-message" id="cvvCartao-error"></nav>
                    </nav>
                </nav>
            </nav>

            <nav id="pix-fields" class="payment-fields" style="display: none;">
                <p>Ao finalizar, um QR Code Pix será gerado para o pagamento.</p>
            </nav>

            <nav id="boleto-fields" class="payment-fields" style="display: none;">
                <p>Ao finalizar, um link ou PDF do boleto será gerado para o pagamento.</p>
            </nav>

            <h2>4. Confirmação</h2>
            <nav class="form-group">
                <label>
                    <input type="checkbox" id="confirmacao" name="confirmacao" required>
                    Confirmo que os dados estão corretos e autorizo o processamento da assinatura.
                </label>
                <nav class="error-message" id="confirmacao-error"></nav>
            </nav>

            <button type="submit" class="btn btn-primary">Concluir Assinatura</button>
        </form>
    </section>
</section>

<script src="/js/validation.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const metodoPagamentoRadios = document.querySelectorAll("input[name=\'metodoPagamento\"]");
        const cartaoFields = document.getElementById("cartao-fields");
        const pixFields = document.getElementById("pix-fields");
        const boletoFields = document.getElementById("boleto-fields");

        metodoPagamentoRadios.forEach(radio => {
            radio.addEventListener("change", function() {
                cartaoFields.style.display = "none";
                pixFields.style.display = "none";
                boletoFields.style.display = "none";

                document.querySelectorAll("#cartao-fields input").forEach(input => input.removeAttribute("required"));

                if (this.value === "cartao") {
                    cartaoFields.style.display = "block";
                    document.getElementById("numeroCartao").setAttribute("required", "required");
                    document.getElementById("validadeCartao").setAttribute("required", "required");
                    document.getElementById("cvvCartao").setAttribute("required", "required");
                } else if (this.value === "pix") {
                    pixFields.style.display = "block";
                } else if (this.value === "boleto") {
                    boletoFields.style.display = "block";
                }
            });
        });

        const planoForm = document.getElementById("planoForm");

        planoForm.addEventListener("submit", function(event) {
            event.preventDefault(); // Impede o envio padrão do formulário

            if (window.submitOnce && window.submitOnce.isLocked(planoForm)) {
                return;
            }

            // Limpar mensagens de erro anteriores
            document.querySelectorAll(".error-message").forEach(el => el.textContent = "");

            if (validatePlanoForm()) {
                if (window.submitOnce) {
                    window.submitOnce.lock(planoForm);
                }

                planoForm.submit(); // Envia o formulário se todas as validações passarem
            }
        });
    });
</script>

<%- include("./partials/footer") %>
