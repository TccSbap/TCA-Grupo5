{
  "name": "ods6-site",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node app.js",
    "start:prod:watch": "node scripts/start-prod-watch.js",
    "start:watch": "node scripts/start-watch.js",
    "test": "jest",
    "test:unit": "jest --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "start:prod": "set DOTENV_CONFIG_PATH=.env.prod&& set NODE_ENV=production&& set USE_MOCK_DB=false&& node app.js",
    "start:mock": "node scripts/start-mock.js"
  },
  "keywords": [
    "ods6",
    "saneamento",
    "denuncias",
    "ongs"
  ],
  "author": "",
  "license": "ISC",
  "description": "Site de denúncias sobre saneamento básico - ODS 6",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "express-validator": "^7.3.2",
    "i": "^0.3.7",
    "multer": "^2.0.2",
    "mysql2": "^3.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "jest": "^29.7.0",
    "node-mocks-http": "^1.16.2",
    "supertest": "^7.1.4"
  }
}
