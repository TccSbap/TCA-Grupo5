<%- include('../partials/header') %>

<section class="admin-container">
    <aside class="admin-sidebar">
        <nav class="admin-nav">
            <nav class="admin-nav-header">
                <h2>Painel Admin</h2>
                <p><%= user.ongName %></p>
            </nav>
            <ul class="admin-nav-links">
                <li><a href="/admin" class="active">Dashboard</a></li>
                <li><a href="/admin/denuncias">Denúncias</a></li>
                <li><a href="/admin/ongs">ONGs</a></li>
                <li><a href="/dashboard">Meu Perfil</a></li>
                <li><a href="/auth/logout">Sair</a></li>
            </ul>
        </nav>
    </aside>
    
    <main class="admin-content">
        <header class="admin-header">
            <h1>Bem-vindo, <%= user.ongName %></h1>
            <p>Gerencie denúncias e ONGs parceiras</p>
        </header>
        
        <section class="admin-stats">
            <article class="stat-card">
                <header class="stat-header">
                    <i class="fas fa-exclamation-circle"></i>
                    <h3>Total de Denúncias</h3>
                </header>
                <nav class="stat-value"><%= totalDenuncias %></nav>
            </article>
            
            <article class="stat-card">
                <header class="stat-header">
                    <i class="fas fa-clock"></i>
                    <h3>Pendentes</h3>
                </header>
                <nav class="stat-value"><%= denunciasPendentes %></nav>
            </article>
            
            <article class="stat-card">
                <header class="stat-header">
                    <i class="fas fa-spinner"></i>
                    <h3>Em Andamento</h3>
                </header>
                <nav class="stat-value"><%= denunciasEmAndamento %></nav>
            </article>
            
            <article class="stat-card">
                <header class="stat-header">
                    <i class="fas fa-check-circle"></i>
                    <h3>Resolvidas</h3>
                </header>
                <nav class="stat-value"><%= denunciasResolvidas %></nav>
            </article>
            
            <article class="stat-card">
                <header class="stat-header">
                    <i class="fas fa-hands-helping"></i>
                    <h3>ONGs Parceiras</h3>
                </header>
                <nav class="stat-value"><%= totalOngs %></nav>
            </article>
        </section>
        
        <section class="admin-actions">
            <article class="action-card">
                <header class="action-header">
                    <i class="fas fa-tasks"></i>
                    <h3>Gerenciar Denúncias</h3>
                </header>
                <p>Visualize, responda e atualize o status das denúncias registradas no sistema.</p>
                <a href="/admin/denuncias" class="btn btn-primary">Acessar</a>
            </article>
            
            <article class="action-card">
                <header class="action-header">
                    <i class="fas fa-building"></i>
                    <h3>Gerenciar ONGs</h3>
                </header>
                <p>Visualize informações sobre as ONGs parceiras e suas atividades.</p>
                <a href="/admin/ongs" class="btn btn-primary">Acessar</a>
            </article>
        </section>
    </main>
</section>

<%- include('../partials/footer') %>
