<%- include("../partials/header") %>
<link rel="stylesheet" href="/stylesheets/admin-dashboard.css">

<section class="admin-dashboard">
    <section class="container">
        <header class="dashboard-header">
            <h1>Painel de Administração</h1>
            <p>Gerencie denúncias e ONGs</p>
        </header>

        <nav class="dashboard-grid">
            <!-- Denúncias Pendentes -->
            <article class="dashboard-card">
                <header class="card-header">
                    <h2>Denúncias Recentes</h2>
                </header>
                <nav class="card-body">
                    <ul class="denuncia-list">
                        <li class="denuncia-item">
                            <nav class="denuncia-info">
                                <h3>Vazamento de água na Rua Nova Mendes</h3>
                                <p>Local: Bairro Brás, Cidade São Paulo</p>
                                <p>Status: <span class="status status-pendente">Pendente</span></p>
                            </nav>
                            <nav class="denuncia-actions">
                                <button class="btn btn-sm btn-info">Responder</button>
                                <button class="btn btn-sm btn-warning">Em Andamento</button>
                                <button class="btn btn-sm btn-success">Resolvida</button>
                                <button class="btn btn-sm btn-danger">Apagar</button>
                            </nav>
                        </li>
                        <li class="denuncia-item">
                            <nav class="denuncia-info">
                                <h3>Esgoto a céu aberto</h3>
                                <p>Local: Avenida Alfa, Cidade Beta</p>
                                <p>Status: <span class="status status-em-andamento">Em Andamento</span></p>
                            </nav>
                            <nav class="denuncia-actions">
                                <button class="btn btn-sm btn-info">Responder</button>
                                <button class="btn btn-sm btn-warning">Em Andamento</button>
                                <button class="btn btn-sm btn-success">Resolvida</button>
                                <button class="btn btn-sm btn-danger">Apagar</button>
                            </nav>
                        </li>
                        <li class="denuncia-item">
                            <nav class="denuncia-info">
                                <h3>Falta de água recorrente</h3>
                                <p>Local: Vila Gama, Cidade Delta</p>
                                <p>Status: <span class="status status-resolvida">Resolvida</span></p>
                            </nav>
                            <nav class="denuncia-actions">
                                <button class="btn btn-sm btn-info">Responder</button>
                                <button class="btn btn-sm btn-warning">Em Andamento</button>
                                <button class="btn btn-sm btn-success">Resolvida</button>
                                <button class="btn btn-sm btn-danger">Apagar</button>
                            </nav>
                        </li>
                    </ul>
                </nav>
            </article>

            <!-- ONGs Cadastradas -->
            <article class="dashboard-card">
                <header class="card-header">
                    <h2>ONGs Cadastradas</h2>
                </header>
                <nav class="card-body">
                    <ul class="ong-list">
                        <li class="ong-item">
                            <nav class="ong-info">
                                <h3>ONG Água Limpa</h3>
                                <p>Foco: Saneamento Básico</p>
                            </nav>
                            <nav class="ong-actions">
                                <button class="btn btn-sm btn-danger">Apagar</button>
                            </nav>
                        </li>
                        <li class="ong-item">
                            <nav class="ong-info">
                                <h3>Guardiões da Água</h3>
                                <p>Foco: Preservação de Recursos Hídricos</p>
                            </nav>
                            <nav class="ong-actions">
                                <button class="btn btn-sm btn-danger">Apagar</button>
                            </nav>
                        </li>
                    </ul>
                </nav>
            </article>
        </nav>
    </section>
</section>

<%- include("../partials/footer") %>

