<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Plataforma de denúncias e mobilização para água limpa e saneamento básico da ODS 6.">
    <meta name="theme-color" content="#2563eb">
    <meta name="application-name" content="ODS 6">
    <meta name="apple-mobile-web-app-title" content="ODS 6">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" href="/pwa/icon-192.png" sizes="192x192" type="image/png">
    <link rel="icon" href="/pwa/icon-512.png" sizes="512x512" type="image/png">
    <link rel="apple-touch-icon" href="/pwa/apple-touch-icon.png" sizes="180x180">
    <title><%= title %> - ODS 6</title>
    <meta property="og:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : title %> - ODS 6">
    <meta property="og:description" content="<%= typeof ogDescription !== 'undefined' ? ogDescription : 'Plataforma de denúncias e mobilização para água limpa e saneamento básico da ODS 6.' %>">
    <meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : '/pwa/icon-512.png' %>">
    <meta property="og:url" content="<%= typeof ogUrl !== 'undefined' ? ogUrl : 'https://ods6.org/' %>">
    <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:site_name" content="ODS 6">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <!-- Header -->
    <header class="header">
        <nav class="navbar">
            <section class="container">
                <nav class="nav-brand">
                    <a href="/" class="logo">
                        <i class="fas fa-tint"></i>
                        <span>ODS 6</span>
                    </a>
                </nav>
                
                <nav class="nav-menu">
                    <ul class="nav-links">
                        <li><a href="/">Início</a></li>
                        <li><a href="/ongs">ONGs</a></li>
                        <li><a href="/denuncias">Denúncias</a></li>
                        <li><a href="/sobre">Sobre</a></li>
                        <li><a href="/contato">Contato</a></li>
                    </ul>
                </nav>
                
                <nav class="nav-auth">
                    <% if (isLoggedIn) { %>
                        <details class="user-menu">
                            <summary class="user-name">
                                <i class="fas fa-user"></i>
                                <%= user.name %>
                                <% if (isAdmin) { %>
                                    <span class="admin-badge">ONG</span>
                                <% } %>
                            </summary>
                            <nav class="dropdown">
                                <a href="/dashboard">Dashboard</a>
                                <a href="/auth/logout">Sair</a>
                            </nav>
                        </details>
                    <% } else { %>
                        <a href="/auth/login" class="btn btn-outline">Entrar</a>
                        <a href="/auth/cadastro" class="btn btn-primary">Cadastrar</a>
                    <% } %>
                </nav>
                
            </section>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        <%- body %>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <section class="container">
            <section class="footer-content">
                <section class="footer-section">
                    <h3>ODS 6 - Água Limpa e Saneamento</h3>
                    <p>Plataforma dedicada a promover o acesso universal à água potável e saneamento básico através de denúncias e ações colaborativas.</p>
                </section>
                
                <section class="footer-section">
                    <h4>Links Úteis</h4>
                    <ul>
                        <li><a href="/">Início</a></li>
                        <li><a href="/ongs">ONGs Parceiras</a></li>
                        <li><a href="/denuncias">Fazer Denúncia</a></li>
                        <li><a href="/sobre">Sobre o Projeto</a></li>
                    </ul>
                </section>
                
                <section class="footer-section">
                    <h4>Contato</h4>
                    <ul>
                        <li><i class="fas fa-envelope"></i> contato@ods6.org</li>
                        <li><i class="fas fa-phone"></i> (11) 9999-9999</li>
                        <li><i class="fas fa-map-marker-alt"></i> São Paulo, SP</li>
                    </ul>
                </section>
                
                <section class="footer-section">
                    <h4>Redes Sociais</h4>
                    <nav class="social-links">
                        <a href="#"><i class="fab fa-facebook"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-linkedin"></i></a>
                    </nav>
                </section>
            </section>
            
            <section class="footer-bottom">
                <p>&copy; 2024 ODS 6 - Todos os direitos reservados.</p>
            </section>
        </section>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
