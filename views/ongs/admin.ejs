<%- include('../partials/header') %>

<section class="admin-section">
    <section class="container">
        <header class="admin-header">
            <h1>Painel Administrativo</h1>
            <p>Gerencie as atividades da <%= ong.name %></p>
        </header>
        
        <section class="admin-stats">
            <article class="stat-card">
                <nav class="stat-icon">
                    <i class="fas fa-clock"></i>
                </nav>
                <nav class="stat-content">
                    <h3><%= pendingDenuncias.length %></h3>
                    <p>Denúncias Pendentes</p>
                </nav>
            </article>
            
            <article class="stat-card">
                <nav class="stat-icon">
                    <i class="fas fa-comments"></i>
                </nav>
                <nav class="stat-content">
                    <h3><%= respondedDenuncias.length %></h3>
                    <p>Denúncias Respondidas</p>
                </nav>
            </article>
            
            <article class="stat-card">
                <nav class="stat-icon">
                    <i class="fas fa-check-circle"></i>
                </nav>
                <nav class="stat-content">
                    <h3><%= respondedDenuncias.filter(d => d.status === 'resolvida').length %></h3>
                    <p>Casos Resolvidos</p>
                </nav>
            </article>
            
            <article class="stat-card">
                <nav class="stat-icon">
                    <i class="fas fa-percentage"></i>
                </nav>
                <nav class="stat-content">
                    <h3><%= respondedDenuncias.length > 0 ? Math.round((respondedDenuncias.filter(d => d.status === 'resolvida').length / respondedDenuncias.length) * 100) : 0 %>%</h3>
                    <p>Taxa de Resolução</p>
                </nav>
            </article>
        </section>
        
        <nav class="admin-tabs">
            <nav class="tab-buttons">
                <button class="tab-btn active" onclick="showTab('pending', event)">
                    Denúncias Pendentes (<%= pendingDenuncias.length %>)
                </button>
                <button class="tab-btn" onclick="showTab('responded', event)">
                    Minhas Respostas (<%= respondedDenuncias.length %>)
                </button>
                <button class="tab-btn" onclick="showTab('ong-info', event)">
                    Informações da ONG
                </button>
            </nav>
            
            <!-- Tab: Denúncias Pendentes -->
            <section id="pending-tab" class="tab-content active">
                <h2>Denúncias Aguardando Resposta</h2>
                
                <% if (pendingDenuncias.length > 0) { %>
                <nav class="denuncias-list">
                    <% pendingDenuncias.forEach(denuncia => { %>
                    <article class="denuncia-item admin">
                        <nav class="denuncia-info">
                            <h3><%= denuncia.title %></h3>
                            <p><%= denuncia.description.substring(0, 150) %>...</p>
                            <nav class="denuncia-meta">
                                <span class="location">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <%= denuncia.location %>
                                </span>
                                <span class="date">
                                    <i class="fas fa-calendar"></i>
                                    <%= new Date(denuncia.createdAt).toLocaleDateString('pt-BR') %>
                                </span>
                                <span class="category">
                                    <i class="fas fa-tag"></i>
                                    <%= (denuncia.category || 'geral').charAt(0).toUpperCase() + (denuncia.category || 'geral').slice(1) %>
                                </span>
                            </nav>
                        </nav>
                        <footer class="denuncia-actions">
                            <a href="/denuncias/<%= denuncia.id %>" class="btn btn-outline">
                                Ver Detalhes
                            </a>
                            <a href="/denuncias/<%= denuncia.id %>#responder" class="btn btn-primary">
                                <i class="fas fa-reply"></i>
                                Responder
                            </a>
                        </footer>
                    </article>
                    <% }) %>
                </nav>
                <% } else { %>
                <nav class="empty-state">
                    <nav class="empty-icon">
                        <i class="fas fa-check-circle"></i>
                    </nav>
                    <h3>Todas as denúncias foram respondidas!</h3>
                    <p>Não há denúncias pendentes no momento. Continue o bom trabalho!</p>
                </nav>
                <% } %>
            </section>
            
            <!-- Tab: Minhas Respostas -->
            <section id="responded-tab" class="tab-content">
                <h2>Denúncias que Você Respondeu</h2>
                
                <% if (respondedDenuncias.length > 0) { %>
                <nav class="denuncias-list">
                    <% respondedDenuncias.forEach(denuncia => { %>
                    <article class="denuncia-item admin">
                        <nav class="denuncia-info">
                            <h3><%= denuncia.title %></h3>
                            <p><%= denuncia.description.substring(0, 150) %>...</p>
                            <nav class="denuncia-meta">
                                <span class="location">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <%= denuncia.location %>
                                </span>
                                <span class="status status-<%= denuncia.status %>">
                                    <%= denuncia.status.replace('_', ' ').charAt(0).toUpperCase() + denuncia.status.replace('_', ' ').slice(1) %>
                                </span>
                                <span class="responses">
                                    <i class="fas fa-comments"></i>
                                    <%= denuncia.responses.filter(r => r.ongId === user.id).length %> resposta(s)
                                </span>
                            </nav>
                        </nav>
                        <footer class="denuncia-actions">
                            <a href="/denuncias/<%= denuncia.id %>" class="btn btn-outline">
                                Ver Detalhes
                            </a>
                            <% if (denuncia.status !== 'resolvida') { %>
                            <a href="/denuncias/<%= denuncia.id %>#responder" class="btn btn-secondary">
                                <i class="fas fa-edit"></i>
                                Atualizar
                            </a>
                            <% } %>
                        </footer>
                    </article>
                    <% }) %>
                </nav>
                <% } else { %>
                <nav class="empty-state">
                    <nav class="empty-icon">
                        <i class="fas fa-comments"></i>
                    </nav>
                    <h3>Você ainda não respondeu nenhuma denúncia</h3>
                    <p>Comece respondendo às denúncias pendentes para ajudar a comunidade.</p>
                </nav>
                <% } %>
            </section>
            
            <!-- Tab: Informações da ONG -->
            <section id="ong-info-tab" class="tab-content">
                <h2>Informações da ONG</h2>
                
                <address class="ong-details">
                    <nav class="detail-group">
                        <label>Nome da ONG:</label>
                        <span><%= ong.name %></span>
                    </nav>
                    
                    <nav class="detail-group">
                        <label>Descrição:</label>
                        <span><%= ong.description %></span>
                    </nav>
                    
                    <nav class="detail-group">
                        <label>Email de Contato:</label>
                        <span><%= ong.contact %></span>
                    </nav>
                    
                    <% if (ong.phone) { %>
                    <nav class="detail-group">
                        <label>Telefone:</label>
                        <span><%= ong.phone %></span>
                    </nav>
                    <% } %>
                    
                    <% if (ong.address) { %>
                    <nav class="detail-group">
                        <label>Endereço:</label>
                        <span><%= ong.address %></span>
                    </nav>
                    <% } %>
                    
                    <nav class="detail-group">
                        <label>Cadastrada em:</label>
                        <span><%= new Date(ong.createdAt).toLocaleDateString('pt-BR', { 
                            year: 'numeric', 
                            month: 'long', 
                            day: 'numeric' 
                        }) %></span>
                    </nav>
                </address>
                
                <nav class="ong-actions">
                    <p><strong>Nota:</strong> Para alterar as informações da ONG, entre em contato com o administrador da plataforma.</p>
                </nav>
            </section>
        </nav>
    </section>
</section>

<script>
function showTab(tabName, event) {
    // Esconder todas as tabs
    document.querySelectorAll('.tab-content').forEach(tab => {
        tab.classList.remove('active');
    });
    
    // Remover classe active de todos os botões
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('active');
    });
    
    // Mostrar tab selecionada
    document.getElementById(tabName + '-tab').classList.add('active');
    
    // Adicionar classe active ao botão correspondente
    event.target.classList.add('active');
}
</script>

<%- include('../partials/footer') %>
