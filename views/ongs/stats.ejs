<%- include('../partials/header') %>

<section class="admin-section">
    <section class="container">
        <header class="admin-header">
            <h1>Estatísticas da ONG</h1>
            <p>Resumo do desempenho da sua ONG na plataforma</p>
        </header>

        <section class="admin-stats">
            <article class="stat-card">
                <nav class="stat-icon">
                    <i class="fas fa-reply"></i>
                </nav>
                <nav class="stat-content">
                    <h3><%= stats.totalResponses %></h3>
                    <p>Total de Respostas</p>
                </nav>
            </article>

            <article class="stat-card">
                <nav class="stat-icon">
                    <i class="fas fa-check-circle"></i>
                </nav>
                <nav class="stat-content">
                    <h3><%= stats.resolvedByOng %></h3>
                    <p>Casos Resolvidos</p>
                </nav>
            </article>

            <article class="stat-card">
                <nav class="stat-icon">
                    <i class="fas fa-clock"></i>
                </nav>
                <nav class="stat-content">
                    <h3><%= stats.pendingDenuncias %></h3>
                    <p>Denúncias Pendentes</p>
                </nav>
            </article>

            <article class="stat-card">
                <nav class="stat-icon">
                    <i class="fas fa-list"></i>
                </nav>
                <nav class="stat-content">
                    <h3><%= stats.totalDenuncias %></h3>
                    <p>Total de Denúncias</p>
                </nav>
            </article>
        </section>
    </section>
</section>

<%- include('../partials/footer') %>
