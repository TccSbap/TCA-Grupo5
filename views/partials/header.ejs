<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Plataforma de denúncias e mobilização para água limpa e saneamento básico da ODS 6.">
    <meta name="theme-color" content="#2563eb">
    <meta name="application-name" content="ODS 6">
    <meta name="apple-mobile-web-app-title" content="ODS 6">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" href="/pwa/icon-192.png" sizes="192x192" type="image/png">
    <link rel="icon" href="/pwa/icon-512.png" sizes="512x512" type="image/png">
    <link rel="apple-touch-icon" href="/pwa/apple-touch-icon.png" sizes="180x180">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <!-- Header -->
    <header class="header">
        <nav class="navbar">
            <nav class="container">
                <nav class="nav-brand">
                    <a href="/" class="logo">
                        <img src="/images/logo.png" alt="ODS 6 Logo" class="logo-img">
                        <span>Água Consciente</span>
                    </a>
                </nav>
                
                <nav class="nav-menu">
                    <ul class="nav-links">
                        <li><a href="/noticias">Notícias</a></li>
                        <li><a href="/ongs">ONGs</a></li>
                        <li><a href="/denuncias">Denúncias</a></li>
                        <li><a href="/sobre">Sobre</a></li>
                        <li><a href="/contato">Contato</a></li>
                        <li><a href="/doacoes">Doações</a></li>
                        <li><a href="/planos">Planos</a></li>
                    </ul>
                </nav>
                
                <nav class="nav-auth">
                    <% if (isLoggedIn) { %>
                        <nav class="user-menu">
                            <span class="user-name">
                                <i class="fas fa-user"></i>
                                <%= user.name %>
                                <% if (isAdmin) { %>
                                    <span class="admin-badge">ONG</span>
                                <% } %>
                            </span>
                            <nav class="dropdown">
                                <a href="/dashboard">Dashboard</a>
                                <% if (isAdmin) { %>
                                <a href="/admin">Painel Admin</a>
                                <% } %>
                                <a href="/auth/logout">Sair</a>
                            </nav>
                        </nav>
                    <% } else { %>
                        <a href="/auth/login" class="btn btn-outline">Entrar</a>
                        <a href="/auth/cadastro" class="btn btn-primary">Cadastrar</a>
                    <% } %>
                </nav>
                
                <nav class="mobile-menu-toggle">
                    <i class="fas fa-bars"></i>
                </nav>
            </nav>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="main-content">
